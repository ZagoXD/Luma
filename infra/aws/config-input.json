{
  "services": {
    "input": {
      "image": "busybox",
      "environment": {
        "Resend__ApiKey": "${RESEND_PRODUCTION_API_KEY:-}",
        "Twilio__VerifyServiceSid": "${TWILIO_PRODUCTION_VERIFY_SERVICE_SID:-}",
        "MercadoPago__AccessToken": "${MERCADOPAGO_PRODUCTION_ACCESS_TOKEN:?Missing production token}",
        "MercadoPago__PublicKey": "${MERCADOPAGO_PRODUCTION_PUBLIC_KEY:?Missing production public key}",
        "MercadoPago__WebhookSecret": "${MERCADOPAGO_PRODUCTION_WEBHOOK_SECRET:?Missing webhook secret}",
        "MercadoPago__SellerId": "${MERCADOPAGO_PRODUCTION_SELLER_ID:?Missing production seller}",
        "MercadoPago__TestMode": "false"
      }
    }
  }
}
