{
  "services": {
    "gateway": {
      "image": "nginx:1.28-alpine", "container_name": "luma-gateway", "restart": "unless-stopped", "mem_limit": "48m",
      "volumes": ["/opt/luma/infra/aws/nginx.conf:/etc/nginx/conf.d/default.conf:ro", "/opt/luma/status:/status:ro"],
      "networks": ["dev", "production", "edge"],
      "logging": {"driver": "json-file", "options": {"max-size": "10m", "max-file": "2"}}
    },
    "cloudflared": {
      "image": "cloudflare/cloudflared:latest", "restart": "unless-stopped", "mem_limit": "96m", "user": "0:0",
      "command": ["tunnel", "--no-autoupdate", "run", "--token-file", "/run/secrets/tunnel"],
      "volumes": ["/opt/luma/cloudflare.token:/run/secrets/tunnel:ro"], "networks": ["edge"],
      "logging": {"driver": "json-file", "options": {"max-size": "5m", "max-file": "2"}}
    }
  },
  "networks": {"dev": {"external": true, "name": "luma-dev-front"},
    "production": {"external": true, "name": "luma-production-front"}, "edge": {}}
}
