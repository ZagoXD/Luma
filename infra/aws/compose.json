{
  "services": {
    "postgres": {
      "image": "pgvector/pgvector:pg16", "restart": "unless-stopped", "mem_limit": "256m",
      "env_file": ["/opt/luma/runtime/${ENVIRONMENT}/postgres.env"],
      "volumes": ["postgres:/var/lib/postgresql/data"], "networks": ["data"],
      "command": ["postgres", "-c", "shared_buffers=32MB", "-c", "max_connections=40"],
      "healthcheck": {"test": ["CMD-SHELL", "pg_isready -U luma -d luma"], "interval": "5s", "timeout": "5s", "retries": 30},
      "logging": {"driver": "json-file", "options": {"max-size": "10m", "max-file": "2"}}
    },
    "redis": {
      "image": "redis:7-alpine", "restart": "unless-stopped", "mem_limit": "80m",
      "command": ["redis-server", "/etc/redis/redis.conf"],
      "volumes": ["redis:/data", "/opt/luma/runtime/${ENVIRONMENT}/redis.conf:/etc/redis/redis.conf:ro"],
      "healthcheck": {"test": ["CMD-SHELL", "REDISCLI_AUTH=$(sed -n 's/^requirepass //p' /etc/redis/redis.conf) redis-cli ping | grep -q PONG"], "interval": "5s", "timeout": "5s", "retries": 30},
      "networks": ["data"],
      "logging": {"driver": "json-file", "options": {"max-size": "5m", "max-file": "2"}}
    },
    "api": {
      "image": "luma-api:${IMAGE_TAG}", "pull_policy": "never", "restart": "unless-stopped", "mem_limit": "320m",
      "env_file": ["/opt/luma/runtime/${ENVIRONMENT}/api.env"],
      "depends_on": {"postgres": {"condition": "service_healthy"}, "redis": {"condition": "service_healthy"}},
      "networks": {"data": {}, "front": {"aliases": ["${ENVIRONMENT}-api"]}},
      "logging": {"driver": "json-file", "options": {"max-size": "10m", "max-file": "3"}}
    },
    "web": {
      "image": "luma-web:${IMAGE_TAG}", "pull_policy": "never", "restart": "unless-stopped", "mem_limit": "256m",
      "env_file": ["/opt/luma/runtime/${ENVIRONMENT}/web.env"],
      "depends_on": ["api"], "networks": {"front": {"aliases": ["${ENVIRONMENT}-web"]}},
      "logging": {"driver": "json-file", "options": {"max-size": "10m", "max-file": "2"}}
    }
  },
  "networks": {"data": {"internal": true}, "front": {"external": true, "name": "luma-${ENVIRONMENT}-front"}},
  "volumes": {"postgres": {}, "redis": {}}
}
